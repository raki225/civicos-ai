# Runtime
CIVICOS_ENV=development
CIVICOS_DATABASE_URL=postgresql+psycopg://civicos:civicos@localhost:5432/civicos
CIVICOS_CORS_ORIGINS=http://localhost:3000
CIVICOS_UPLOAD_DIR=./uploads
CIVICOS_MAX_UPLOAD_MB=15

# Development authentication (disabled automatically in production)
CIVICOS_ALLOW_DEMO_AUTH=true

# Firebase Admin (required for production authentication)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional AI integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Specialized, validated pothole/road-damage YOLO weights. Generic COCO weights are not sufficient.
CIVICOS_YOLO_WEIGHTS=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

